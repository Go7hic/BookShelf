{
  "name": "bookshelf-react",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/bookshelf-react.umd.cjs",
  "module": "./dist/bookshelf-react.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/bookshelf-react.js",
      "require": "./dist/bookshelf-react.umd.cjs"
    },
    "./style.css": "./dist/bookshelf-react.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "verify:component-contract": "node scripts/verify-component-contract.mjs"
  },
  "dependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  }
}
